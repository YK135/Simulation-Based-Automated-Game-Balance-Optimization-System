# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 데이터베이스 (런타임 생성) ──
ai_rpg.db
*.db
*.sqlite
*.sqlite3

# ── 비밀값 ──
# .env.example만 커밋한다. 실제 .env에는 DATABASE_URL(Render가 발급하는 URL은
# DB 접속 비밀번호를 포함한다)과 SECRET_KEY가 들어가므로 절대 추적하지 않는다.
.env
.env.*
!.env.example

# ── 런타임 데이터 / 로그 ──
data/
data/RL_LOG/

# ── 분석 산출물 (Monte Carlo) ──
analysis_outputs/
mc_results.json
mc_*.json

# ── OS / 기타 ──
.DS_Store
**/.DS_Store
cookies.txt
FETCH_HEAD

# ── 에디터 ──
.vscode/
.idea/
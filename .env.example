# 이 파일을 .env로 복사해서 실제 값 채우기 (.env는 git에 커밋하지 말 것)

# Flask 세션 쿠키 서명 키 — 반드시 실제 배포 전에 랜덤 값으로 교체
# 생성 예: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# 개발 서버 디버그 모드 — 프로덕션에서는 반드시 0 (또는 아예 미설정)
FLASK_DEBUG=0

# 서버 포트 (대부분의 PaaS가 자동으로 주입함 — 로컬 개발 시에만 직접 지정)
PORT=5000

# DB 연결 문자열 — 미설정 시 로컬 sqlite:///ai_rpg.db 사용
# 멀티 워커로 배포한다면 SQLite는 동시쓰기에 취약하므로 Postgres 필수
# 예: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# 세션 2차 캐시(Redis) — 미설정 시 자동으로 메모리+DB 2단계로만 동작
# (Redis 없어도 게임은 정상 동작 — 워커 재시작 복구가 조금 느려질 뿐)
# 예: redis://user:password@host:6379/0
REDIS_URL=

# ─────────────────────────────────────────────
# 배포 시 코드 밖에서 반드시 확인할 것 (이 .env로는 설정 불가)
# ─────────────────────────────────────────────
# 1) 리버스 프록시/로드밸런서에서 "쿠키 기반 스티키 세션" 활성화
#    — 안 켜면 진행 중인 전투가 매 요청마다 다른 워커로 튈 수 있음
# 2) Redis/Postgres 인스턴스 프로비저닝 (관리형 애드온 권장)
